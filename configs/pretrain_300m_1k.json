{
  "run_name": "pretrain-300m-1k",
  "seed": 1337,
  "model": {
    "vocab_size": 50000,
    "max_seq_len": 1024,
    "n_layers": 22,
    "d_model": 1024,
    "n_heads": 16,
    "n_kv_heads": 4,
    "ffn_hidden_dim": 2816,
    "dropout": 0.0,
    "rope_base": 10000.0,
    "rope_pct": 0.5,
    "mtp_heads": 2,
    "mtp_weight": 0.5,
    "mtp_decay": 0.5,
    "tie_word_embeddings": true,
    "use_bias": false,
    "initializer_std": 0.02
  },
  "data": {
    "train_glob": "",
    "val_glob": "",
    "tokenizer_backend": "auto",
    "tokenizer_path": "Tokenizer/V1/tokenizer.json",
    "text_column": "auto",
    "candidate_text_columns": ["text", "plain_text", "content", "document"],
    "add_bos": false,
    "add_eos": true,
    "shuffle_files": true,
    "row_batch_size": 128,
    "num_workers": 0
  },
  "optimizer": {
    "adamw_lr": 0.0003,
    "adamw_betas": [0.9, 0.95],
    "adamw_eps": 1e-08,
    "adamw_weight_decay": 0.1,
    "adamw_fused": true,
    "muon_lr": 0.0003,
    "muon_weight_decay": 0.1,
    "muon_momentum": 0.95,
    "muon_nesterov": true,
    "muon_ns_steps": 5,
    "muon_adjust_lr_fn": "match_rms_adamw"
  },
  "trainer": {
    "device": "auto",
    "precision": "bf16",
    "matmul_precision": "high",
    "compile_model": false,
    "micro_batch_size": 4,
    "gradient_accumulation_steps": 32,
    "max_steps": 200000,
    "warmup_steps": 2000,
    "lr_decay_steps": 200000,
    "min_lr_ratio": 0.1,
    "clip_grad_norm": 1.0,
    "log_every": 20,
    "eval_every": 1000,
    "eval_batches": 50,
    "save_every": 1000,
    "keep_last_n_checkpoints": 5,
    "resume_from": "auto",
    "output_dir": "outputs",
    "sample_every": 0,
    "sample_tokens": 128,
    "sample_prompt": "The future of open language models is"
  },
  "logging": {
    "enable_csv": true,
    "enable_jsonl": true,
    "enable_tensorboard": true,
    "enable_plot": true,
    "plot_every": 100
  }
}
