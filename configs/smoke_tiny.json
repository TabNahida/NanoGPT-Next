{
  "run_name": "smoke-tiny",
  "seed": 1337,
  "model": {
    "vocab_size": 50000,
    "max_seq_len": 64,
    "n_layers": 2,
    "d_model": 128,
    "n_heads": 4,
    "n_kv_heads": 2,
    "ffn_hidden_dim": 256,
    "dropout": 0.0,
    "rope_base": 10000.0,
    "rope_pct": 0.5,
    "mtp_heads": 1,
    "mtp_weight": 0.25,
    "mtp_decay": 0.5,
    "tie_word_embeddings": true,
    "use_bias": false,
    "initializer_std": 0.02
  },
  "data": {
    "train_glob": "tmp/smoke/*.parquet",
    "val_glob": "",
    "tokenizer_backend": "hf",
    "tokenizer_path": "Tokenizer/V1/tokenizer.json",
    "text_column": "text",
    "candidate_text_columns": ["text"],
    "add_bos": false,
    "add_eos": true,
    "shuffle_files": true,
    "row_batch_size": 16,
    "num_workers": 0
  },
  "optimizer": {
    "adamw_lr": 0.001,
    "adamw_betas": [0.9, 0.95],
    "adamw_eps": 1e-08,
    "adamw_weight_decay": 0.01,
    "adamw_fused": false,
    "muon_lr": 0.001,
    "muon_weight_decay": 0.01,
    "muon_momentum": 0.95,
    "muon_nesterov": true,
    "muon_ns_steps": 3,
    "muon_adjust_lr_fn": "match_rms_adamw"
  },
  "trainer": {
    "device": "auto",
    "precision": "bf16",
    "matmul_precision": "high",
    "compile_model": false,
    "micro_batch_size": 2,
    "gradient_accumulation_steps": 2,
    "max_steps": 4,
    "warmup_steps": 1,
    "lr_decay_steps": 4,
    "min_lr_ratio": 0.5,
    "clip_grad_norm": 1.0,
    "log_every": 1,
    "eval_every": 0,
    "eval_batches": 0,
    "save_every": 2,
    "keep_last_n_checkpoints": 0,
    "resume_from": "",
    "output_dir": "outputs",
    "sample_every": 0,
    "sample_tokens": 32,
    "sample_prompt": "NanoGPT-Next"
  },
  "logging": {
    "enable_csv": true,
    "enable_jsonl": true,
    "enable_tensorboard": false,
    "enable_plot": true,
    "plot_every": 1
  }
}
